@startuml clases_tablero
title Entrega 1 - Diagrama de Clases: Tablero, Casillas y Terrenos

hide circle
skinparam classAttributeIconSize 0
top to bottom direction

class LectorTableroCSV {
  + transformarArchivo(mapa:File):List<Casilla>
}

class Tablero {
  + Tablero(mapa:File)
  + posicionarUnidad(pos:Posicion, u:Unidad)
  + moverUnidad(orig:Posicion, dest:Posicion)
  + deshacerMovimiento(posActual:Posicion)
  + movimientosValidosDesde(orig:Posicion):List<Posicion>
  + atacar(pos:Posicion, danio:int)
  + empujarUnidad(orig:Posicion, dir:Direccion)
  + buscarPrimerImpacto(orig:Posicion, dir:Direccion):Posicion
  + estaDentro(pos:Posicion):boolean
  + estaOcupada(pos:Posicion):boolean
  + unidadEstaEn(u:Unidad, pos:Posicion):boolean
  + esIgualA(otro:Tablero):boolean
  - casillaEn(pos:Posicion):Casilla
}

class Posicion {
  - fila:int
  - columna:int
  + Posicion(fila:int, columna:int)
  + obtenerAdyacente(dir:Direccion):Posicion
  + distanciaACelda(otra:Posicion):int
  + estaAlineadaCon(otra:Posicion):boolean
  + direccionHacia(otra:Posicion):Direccion
  + esIgualA(otra:Posicion):boolean
}

class Direccion {
  - deltaFila:int
  - deltaColumna:int
  + fila():int
  + columna():int
}

class Casilla {
  - unidad:Unidad
  + Casilla(terreno:Terreno)
  + recibirUnidad(u:Unidad)
  + liberar()
  + ocupada():boolean
  + puedeRecibirUnidad(u:Unidad):boolean
  + suUnidadPuedeRecorrer(casillas:int):boolean
  + suUnidadPuedeEntrarEn(dest:Casilla):boolean
  + moverUnidadA(dest:Casilla)
  + deshacerMovimientoHacia(orig:Casilla)
  + recibirAtaque(danio:int)
  + empujarUnidadHacia(dest:Casilla)
  + recibirUnidadEmpujada(empujada:Unidad, orig:Casilla)
  + dejarPasar(empujada:Unidad, orig:Casilla)
  + detieneDisparos():boolean
  + contiene(u:Unidad):boolean
}

abstract class Terreno {
  + esTransitable():boolean
  + bloqueaDisparos():boolean
  + recibirAtaque(danio:int)
  + recibirUnidadEmpujada(empujada:Unidad, orig:Casilla, dest:Casilla)
}

class Suelo {
  + esTransitable():boolean
  + bloqueaDisparos():boolean
  + recibirUnidadEmpujada(empujada:Unidad, orig:Casilla, dest:Casilla)
}

class Agua {
  + esTransitable():boolean
  + bloqueaDisparos():boolean
}

class Montania {
  + esTransitable():boolean
}

class FueraDelTablero {
  + recibirUnidadEmpujada(empujada:Unidad, orig:Casilla, dest:Casilla)
}

class Edificio {
  - estaDestruido:boolean
  + Edificio(red:RedElectrica)
  + recibirAtaque(danio:int)
  + recibirUnidadEmpujada(empujada:Unidad, orig:Casilla, dest:Casilla)
}

class RedElectrica {
  - energia:int
  + RedElectrica(energiaInicial:int)
  + restarEnergia(cantidad:int)
  + estaActivo():boolean
}

Tablero .up.> LectorTableroCSV
Tablero .down.> Posicion
Posicion .right.> Direccion
Posicion -[hidden]down-> Casilla

Tablero "1" *-down- "64" Casilla
Casilla "1" *-down- "1" Terreno

Terreno <|-down- Suelo
Terreno <|-down- Agua
Terreno <|-down- Montania
Terreno <|-down- FueraDelTablero
Terreno <|-down- Edificio

Suelo -[hidden]down-> FueraDelTablero
Agua -[hidden]down-> Edificio
Edificio "*" -down-> "1" RedElectrica
@enduml