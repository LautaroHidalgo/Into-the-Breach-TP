@startuml
'https://plantuml.com/sequence-diagram


class Partida {
    - turnosTotales
    - turnoActual
    - fase: Fase

}

Partida o-- Tablero
Partida --> Fase
Partida --> EvaluadorFinDePartida

class EvaluadorFinDePartida {
}

EvaluadorFinDePartida ..> ResultadoPartida

class  ResultadoPartida <enumaration>{
    EN_CURSO
    VICTORIA
    DERROTA
}

interface Fase {}

Fase <.. FaseVek
Fase <.. FaseJugador
Fase <.. FaseResolucion
Fase <.. FaseEmergencia

class FaseVek
class FaseJugador
class FaseResolucion
class FaseEmergencia

class Tablero{
    - casillas: Map<Posicion, Casilla>
}

Tablero o-- "64" Casilla

class Casilla {
    - terreno : Terreno
    - ocupante: Unidad
}

Casilla --> Terreno
Casilla --> Unidad
abstract class Terreno{
}

class Edificio {}
Edificio --> RedElectrica

class Suelo {}
class Montaña {}
class Agua {}
class Acido {}

Terreno <|-- Edificio
Terreno <|-- Suelo
Terreno <|-- Montaña
Terreno <|-- Agua
Terreno <|-- Acido

abstract class  Unidad {
    - vida: int
    - movimiento: int
    - salud: EstadoSalud
}

Unidad <|-- Mech
Unidad <|-- Vek

interface EstadoSalud {
   +calcularDanio(base: int ): int
}

Unidad --> EstadoSalud
EstadoSalud <-- Sano
EstadoSalud <-- Contaminado
class Sano{}
class Contaminado{}

abstract class Mech {
    -arma: Arma

}

abstract class Vek {
    - arma: Arma
    - comportamiento : Comportamiento
}


class MechArtilleria {}
class MechCanon {}
class MechCombate{}

Mech <|-- MechArtilleria
Mech <|-- MechCanon
Mech <|-- MechCombate

class Luciernaga {}
class Saltador{}
class Avispon{}

Vek <|-- Luciernaga
Vek <|-- Saltador
Vek <|-- Avispon

class Terrestre {}
MechCombate ..>  Terrestre
MechCanon ..>  Terrestre
MechArtilleria ..>  Terrestre
Luciernaga ..>  Terrestre
Saltador ..> Terrestre

class Volador {}
Avispon ..>  Volador

class Arma {
    - alcance : Alcance
    - efectos : Efecto
}

Mech ---> Arma
Vek ---> Arma

interface Alcance {
}

Arma --> Alcance
Alcance <.. Adyacente
Alcance <.. PrimeraEnLinea
Alcance <.. Arco

class Adyacente{}
class PrimeraEnLinea{}
class Arco{}

interface Efecto {
}

Efecto  <.. Danio
Efecto <.. Empuje
Efecto <.. EmpujeRadial
Efecto <.. Contaminar
Arma o-- "1..*" Efecto

class Danio{
    - cantidad: int
}
class Empuje{}
class EmpujeRadial{}
class Contaminar{}

interface Impactable {
    + recibirDanio(cantidad: int)
}

Edificio ..> Impactable
Unidad ..> Impactable
@enduml