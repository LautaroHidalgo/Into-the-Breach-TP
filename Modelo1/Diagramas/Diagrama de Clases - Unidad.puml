@startuml Modelo1
title Modelo1 - Diagrama de clases de Unidad

hide circle
skinparam classAttributeIconSize 0
skinparam style strictuml

abstract class Unidad {
  - vida : int
  + puedeAtravesar(terreno : Terreno) : boolean
  + puedeTerminarEn(terreno : Terreno) : boolean
  + recibirDanio(cantidad : int)
  + recibirContaminacion()
}

enum EstadoSalud {
  SANO
  CONTAMINADO
}

abstract class Mech {
  - arma : Arma
  - movimientoRealizado : boolean
  - ataqueRealizado : boolean
  + atacar(origen : Posicion, objetivo : Posicion, tablero : Tablero)
  + asentarAtaque()
  + reiniciarAcciones()
}

abstract class Vek {
  - direccionAtaqueAnunciado : Direccion
  + anunciarAtaque(direccion : Direccion)
  + ejecutarAtaque(origen : Posicion, tablero : Tablero)
}

Unidad <|-- Mech
Unidad <|-- Vek

class MechCombate
class MechCanon
class MechArtilleria

Mech <|-- MechCombate
Mech <|-- MechCanon
Mech <|-- MechArtilleria

class Saltador
class Luciernaga
class Avispon

Vek <|-- Saltador
Vek <|-- Luciernaga
Vek <|-- Avispon

abstract class Arma {
  - danio : int
  + atacar(tablero : Tablero, origen : Posicion, objetivo : Posicion)
}

class Puno
class Canon
class Artilleria

Arma <|-- Puno
Arma <|-- Canon
Arma <|-- Artilleria

Mech --> Arma

Unidad --> "1" EstadoSalud : estadoSalud

@enduml