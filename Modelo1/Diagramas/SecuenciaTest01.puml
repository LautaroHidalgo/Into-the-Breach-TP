
@startuml
title Caso de Uso: Artillería impacta a un Vek y empuja a otro contra un Edificio

hide footbox
skinparam style strictuml
skinparam SequenceMessageAlign center

actor ":TestCase01" as test

participant "mechArtilleria:MechArtilleria" as mech
participant "artilleria:Artilleria" as arma
participant "tablero:Tablero" as tablero
participant "objetivo:Posicion" as objetivo
participant "adyacente:Posicion" as posAdy
participant "casillaObjetivo:Casilla" as casillaObj
participant "vekObjetivo:Vek" as vekObj
participant "casillaAdyacente:Casilla" as casillaAdy
participant "vekAdyacente:Vek" as vekAdy
participant "casillaDestino:Casilla" as casillaDestino
participant "edificio:Edificio" as edificio
participant "redElectrica:RedElectrica" as red
participant "Suelo" as claseSuelo <<class>>
participant "suelo:Suelo" as suelo

' 1. INICIO DEL ATAQUE

test -> mech : atacar(origen, objetivo, tablero)
activate mech

mech -> arma : atacar(tablero, origen, objetivo)
activate arma

' 2. IMPACTO EN LA CASILLA OBJETIVO

arma -> tablero : obtenerCasilla(objetivo)
activate tablero
tablero --> arma : casillaObjetivo
deactivate tablero

arma -> casillaObj : recibirAtaque(1)
activate casillaObj

casillaObj -> vekObj : recibirDanio(1)
activate vekObj
vekObj --> casillaObj
deactivate vekObj

casillaObj --> arma
deactivate casillaObj

' 3. EMPUJE RADIAL

note over arma, tablero
La Artillería procesa las cuatro direcciones.
Se detalla únicamente aquella donde
un Vek colisiona contra un Edificio.
end note

arma -> objetivo : obtenerAdyacente(direccion)
activate objetivo
objetivo --> arma : posicionAdyacente
deactivate objetivo

arma -> tablero : empujarUnidad(posicionAdyacente, direccion)
activate tablero

' 4. TABLERO LOCALIZA ORIGEN Y DESTINO

tablero -> posAdy : obtenerAdyacente(direccion)
activate posAdy
posAdy --> tablero : posicionDestino
deactivate posAdy

tablero -> tablero : obtenerCasilla(posicionAdyacente)
tablero --> tablero : casillaAdyacente

tablero -> tablero : obtenerCasilla(posicionDestino)
tablero --> tablero : casillaDestino

' 5. DESPLAZAMIENTO FORZADO

tablero -> casillaAdy : empujarUnidadHacia(casillaDestino)
activate casillaAdy

casillaAdy -> casillaDestino : recibirUnidadDesplazada(vekAdyacente, casillaAdyacente)
activate casillaDestino

casillaDestino -> edificio : recibirUnidadDesplazada(vekAdyacente, casillaDestino)
activate edificio

' 6. COLISIÓN

edificio -> vekAdy : recibirDanio(1)
activate vekAdy
vekAdy --> edificio
deactivate vekAdy

edificio -> edificio : recibirAtaque(1)

edificio -> red : restarVida(1)
activate red
red --> edificio
deactivate red

' 7. DESTRUCCIÓN DEL EDIFICIO
' Precondición: edificio tenía 1 punto de vida

edificio -> claseSuelo : new()
activate claseSuelo

create suelo
claseSuelo -> suelo : <<create>> Suelo()
activate suelo
suelo --> claseSuelo
deactivate suelo

claseSuelo --> edificio : suelo
deactivate claseSuelo

edificio -> casillaDestino : cambiarTerreno(suelo)

note over casillaAdy, casillaDestino
La colisión impide el traslado.
El Vek permanece en su casilla original.
El edificio recibe daño y es destruido, 
por lo que se la casilla cambia su tipo de terreno a suelo.

end note

edificio --> casillaDestino
deactivate edificio

casillaDestino --> casillaAdy
deactivate casillaDestino

casillaAdy --> tablero
deactivate casillaAdy

tablero --> arma
deactivate tablero

arma --> mech
deactivate arma

mech --> mech :asentarAtaque()
activate mech
note right of mech
    ataqueRealizado = true
end note
deactivate mech
mech --> test
deactivate mech

@enduml
