@startuml clases_unidades
title Entrega 1 - Unidades, estado de salud y estado de turno

hide circle
hide empty members
skinparam classAttributeIconSize 0

abstract class Unidad {
  + {static} DANIO_COLISION : int = 1
  - vida : int
  - movimiento : int
  - estadoSalud : EstadoSalud
  - estadoTurno : EstadoTurno
  + recibirDanio(cantidad : int)
  + recibirContaminacion()
  + estaViva() : boolean
  + puedeRecorrer(casillas : int) : boolean
  + ocupaCasilla() : boolean
  + serEmpujada(origen : Casilla, destino : Casilla)
  + chocarCon(empujada : Unidad, origen : Casilla, destino : Casilla)
  + registrarMovimiento()
  + deshacerMovimiento()
  + verificarQuePuedeAtacar()
  + registrarAtaque()
  + reiniciarTurno()
  + vida() : int
}

abstract class Mech {
  - arma : Arma
  + atacar(origen : Posicion, objetivo : Posicion, tablero : Tablero)
}

abstract class Vek

class SinUnidad {
  + ocupaCasilla() : boolean
  + recibirDanio(cantidad : int)
  + serEmpujada(origen : Casilla, destino : Casilla)
  + chocarCon(empujada : Unidad, origen : Casilla, destino : Casilla)
}

class MechCombate
class MechCanon
class MechArtilleria
class Saltador
class Luciernaga
class Avispon

interface EstadoSalud {
  + calcularDanio(danioBase : int) : int
  + contaminar() : EstadoSalud
}
class Sano
class Contaminado

abstract class EstadoTurno {
  + registrarMovimiento() : EstadoTurno
  + deshacerMovimiento() : EstadoTurno
  + verificarQuePuedeAtacar()
  + registrarAtaque() : EstadoTurno
}
class Disponible
class Movido
class MovimientoDeshecho
class MovidoSinRetorno
class Agotado

abstract class Arma

Unidad <|-- Mech
Unidad <|-- Vek
Unidad <|-- SinUnidad
Mech <|-- MechCombate
Mech <|-- MechCanon
Mech <|-- MechArtilleria
Vek <|-- Saltador
Vek <|-- Luciernaga
Vek <|-- Avispon

Unidad --> "1" EstadoSalud
EstadoSalud <|.. Sano
EstadoSalud <|.. Contaminado

Unidad --> "1" EstadoTurno
EstadoTurno <|-- Disponible
EstadoTurno <|-- Movido
EstadoTurno <|-- MovimientoDeshecho
EstadoTurno <|-- MovidoSinRetorno
EstadoTurno <|-- Agotado

Mech --> "1" Arma

note right of SinUnidad
  Null Object: ocupa una casilla vacía.
  No recibe daño, no se deja empujar y,
  si le empujan una unidad encima,
  le pasa la decisión al terreno.
end note

note bottom of Contaminado
  calcularDanio devuelve el doble.
  contaminar() devuelve this:
  la contaminación no se acumula.
end note

note right of MechCombate
  Vida 3, movimiento 3, Puño
end note
note right of MechCanon
  Vida 3, movimiento 3, Cañón
end note
note right of MechArtilleria
  Vida 2, movimiento 3, Artillería
end note
@enduml