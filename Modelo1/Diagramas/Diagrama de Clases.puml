@startuml Modelo1
title Modelo1 - Diagrama de clases

hide circle
skinparam classAttributeIconSize 0
skinparam style strictuml


class Partida {
  - turnoActual : int
  + iniciar()
  + avanzarFase()
  + avanzarTurno()
  + verificarFinDePartida()
}

enum Fase {
  VEK
  JUGADOR
  RESOLUCION
  EMERGENCIA
}

class Tablero {
  - alcanceMovimiento : int
  + moverUnidad(origen : Posicion, destino : Posicion)
  + deshacerMovimiento(destinoActual : Posicion, origenAnterior : Posicion)
  + movimientosValidosDesde(origen : Posicion)
  + empujarUnidad(origen : Posicion, direccion : Direccion)
  + obtenerCasilla(posicion : Posicion) : Casilla
}

class Casilla {
  + estaLibre() : boolean
  + puedeRecibir(unidad : Unidad) : boolean
  + recibirUnidad(unidad : Unidad)
  + trasladarUnidadA(destino : Casilla)
  + empujarUnidadHacia(destino : Casilla)
  + recibirUnidadDesplazada(unidad : Unidad, origen : Casilla)
  + recibirAtaque(danio : int)
  + cambiarTerreno(nuevoTerreno : Terreno)
}

enum Direccion {
  ARRIBA
  ABAJO
  IZQUIERDA
  DERECHA
}

class Posicion {
  - fila : int
  - columna : int
  + obtenerAdyacente(direccion : Direccion) : Posicion
  + distanciaACelda(otra : Posicion) : int
  - distanciaACoordenadas(fila : int, columna : int) : int
  + esIgualA(otra : Posicion) : boolean
  - compararme(fila : int, columna : int) : boolean
  + equals(otro : Object) : boolean
  + hashCode() : int
}

abstract class Terreno {
  + permiteIngreso(unidad : Unidad) : boolean
  + recibirAtaque(danio : int)
  + aplicarEfecto(unidad : Unidad)
  + recibirUnidadDesplazada(unidad : Unidad, casilla : Casilla)
}

class Suelo
class Agua
class Acido
class Montana

class Edificio {
  - vida : int
  - redElectrica : RedElectrica
  + recibirAtaque(danio : int)
  + recibirUnidadDesplazada(unidad : Unidad, casilla : Casilla)
}

Terreno <|-- Suelo
Terreno <|-- Agua
Terreno <|-- Acido
Terreno <|-- Montana
Terreno <|-- Edificio

class RedElectrica {
  - puntos : int
  + restarVida(cantidad : int)
  + estaAgotada() : boolean
}

abstract class Unidad {
  - vida : int
  + puedeAtravesar(terreno : Terreno) : boolean
  + puedeTerminarEn(terreno : Terreno) : boolean
  + recibirDanio(cantidad : int)
  + recibirContaminacion()
}

enum EstadoSalud {
  SANO
  CONTAMINADO
}

abstract class Mech {
  - arma : Arma
  - movimientoRealizado : boolean
  - ataqueRealizado : boolean
  + atacar(origen : Posicion, objetivo : Posicion, tablero : Tablero)
  + asentarAtaque()
  + reiniciarAcciones()
}

abstract class Vek {
  - direccionAtaqueAnunciado : Direccion
  + anunciarAtaque(direccion : Direccion)
  + ejecutarAtaque(origen : Posicion, tablero : Tablero)
}

Unidad <|-- Mech
Unidad <|-- Vek

class MechCombate
class MechCanon
class MechArtilleria

Mech <|-- MechCombate
Mech <|-- MechCanon
Mech <|-- MechArtilleria

class Saltador
class Luciernaga
class Avispon

Vek <|-- Saltador
Vek <|-- Luciernaga
Vek <|-- Avispon

abstract class Arma {
  - danio : int
  + atacar(tablero : Tablero, origen : Posicion, objetivo : Posicion)
}

class Puno
class Canon
class Artilleria

Arma <|-- Puno
Arma <|-- Canon
Arma <|-- Artilleria

Partida *-- Tablero
Partida *-- RedElectrica

Tablero "1"*-- "64" Casilla
Tablero ..> Posicion

Casilla *-- Terreno
Casilla o-- "0..1" Unidad

Edificio --> RedElectrica
Mech --> Arma

Unidad --> "1" EstadoSalud : estadoSalud
Partida --> "1" Fase : faseActual
Vek --> "0..1" Direccion : direccionAtaqueAnunciado

Posicion ..> Direccion : obtenerAdyacente()
Tablero ..> Direccion : empujarUnidad()

@enduml