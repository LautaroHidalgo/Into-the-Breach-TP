@startuml clases_general
title Entrega 1 - Vista general del modelo

hide circle
hide members
skinparam linetype ortho

class Tablero
class Posicion
enum Direccion
class LectorTableroCSV

class Casilla
class Terreno
class Suelo
class Agua
class Montania
class Edificio
class FueraDelTablero
class RedElectrica

abstract class Unidad
abstract class Mech
abstract class Vek
class SinUnidad
class MechCombate
class MechCanon
class MechArtilleria
class Saltador
class Luciernaga
class Avispon
interface EstadoSalud
class Sano
class Contaminado
abstract class EstadoTurno
class Agotado
class Disponible
class Movido
class MovimientoDeshecho
class MovimientoSinRetorno

abstract class Arma
class Puno
class Canon
class Artilleria

Tablero "1" *--- "64" Casilla : casillas
Tablero "1" --> "0..*" Posicion : origenesDeMovimientos
Tablero ..> LectorTableroCSV
Posicion ..> Direccion

Casilla "1" *---- "1" Terreno
Casilla "1" --> "0..1" Unidad
Terreno <|-- Suelo
Terreno <|-- Agua
Terreno <|-- Montania
Terreno <|-- Edificio
Terreno <|-- FueraDelTablero
Edificio "1" --> "1" RedElectrica

Unidad <|-- Mech
Unidad <|--- Vek
Unidad <|-- SinUnidad
Mech <|-- MechCombate
Mech <|-- MechCanon
Mech <|-- MechArtilleria
Vek <|-- Saltador
Vek <|-- Luciernaga
Vek <|-- Avispon
Unidad "1" ----> "1" EstadoSalud
EstadoSalud <|.. Sano
EstadoSalud <|.. Contaminado
Unidad "1" ---> "1" EstadoTurno
EstadoTurno <|--- Agotado
EstadoTurno <|--- Disponible
EstadoTurno <|--- Movido
EstadoTurno <|--- MovimientoDeshecho
EstadoTurno <|--- MovimientoSinRetorno
Mech "1" *-- "1" Arma
Arma <|-- Puno
Arma <|-- Canon
Arma <|-- Artilleria
Arma ..> Tablero
@enduml
