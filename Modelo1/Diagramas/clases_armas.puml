@startuml clases_armas
title Entrega 1 - Diagrama de Clases: Armas

hide circle
skinparam classAttributeIconSize 0
top to bottom direction

abstract class Mech {
  + atacar(orig:Posicion, obj:Posicion, t:Tablero)
}

class ObjetivoInvalidoException {
  + ObjetivoInvalidoException(mensaje:String)
}

abstract class Arma {
  - danio:int
  # Arma(danio:int)
  + atacar(t:Tablero, orig:Posicion, obj:Posicion)
  # {abstract} alcanza(orig:Posicion, obj:Posicion):boolean
  # {abstract} disparar(t:Tablero, orig:Posicion, obj:Posicion, dir:Direccion)
}

class Puno {
  - {static} DANIO:int
  # alcanza(orig:Posicion, obj:Posicion):boolean
  # disparar(t:Tablero, orig:Posicion, obj:Posicion, dir:Direccion)
}

class Canon {
  - {static} DANIO:int
  # alcanza(orig:Posicion, obj:Posicion):boolean
  # disparar(t:Tablero, orig:Posicion, obj:Posicion, dir:Direccion)
}

class Artilleria {
  - {static} DANIO:int
  - {static} DISTANCIA_MINIMA:int
  # alcanza(orig:Posicion, obj:Posicion):boolean
  # disparar(t:Tablero, orig:Posicion, obj:Posicion, dir:Direccion)
}

class Tablero {
  + estaDentro(pos:Posicion):boolean
  + atacar(pos:Posicion, danio:int)
  + empujarUnidad(orig:Posicion, dir:Direccion)
  + buscarPrimerImpacto(orig:Posicion, dir:Direccion):Posicion
}

Mech "1" -down-> "1" Arma
Arma .up.> ObjetivoInvalidoException
Arma .down.> Tablero

Arma <|-down- Puno
Arma <|-down- Canon
Arma <|-down- Artilleria

Tablero -[hidden]down-> Puno
Puno -[hidden]down-> Canon
Canon -[hidden]down-> Artilleria
@enduml