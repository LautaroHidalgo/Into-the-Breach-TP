@startuml clases_unidades
title Entrega 1 - Diagrama de Clases: Unidades, Estado de Salud y Estado de Turno

hide circle
skinparam classAttributeIconSize 0
top to bottom direction

abstract class Unidad {
  - {static} DANIO_COLISION:int
  - vida:int
  - movimiento:int
  # Unidad(vida:int, movimiento:int)
  + recibirDanio(cantidad:int)
  + recibirContaminacion()
  + estaViva():boolean
  + puedeRecorrer(casillas:int):boolean
  + ocupaCasilla():boolean
  + serEmpujada(orig:Casilla, dest:Casilla)
  + chocarCon(empujada:Unidad, orig:Casilla, dest:Casilla)
  + registrarMovimiento()
  + deshacerMovimiento()
  + verificarQuePuedeAtacar()
  + registrarAtaque()
  + reiniciarTurno()
  + vida():int
}

interface "<<Interfaz>>\nEstadoSalud" as EstadoSalud {
  + calcularDanio(danioBase:int):int
  + contaminar():EstadoSalud
}
class Sano
class Contaminado

abstract class EstadoTurno {
  + registrarMovimiento():EstadoTurno
  + deshacerMovimiento():EstadoTurno
  + verificarQuePuedeAtacar()
  + registrarAtaque():EstadoTurno
}
class Disponible {
  + registrarMovimiento():EstadoTurno
  + deshacerMovimiento():EstadoTurno
}
class Movido {
  + deshacerMovimiento():EstadoTurno
}
class MovimientoDeshecho {
  + registrarMovimiento():EstadoTurno
}
class MovidoSinRetorno {
  + deshacerMovimiento():EstadoTurno
}
class Agotado {
  + deshacerMovimiento():EstadoTurno
  + verificarQuePuedeAtacar()
  + registrarAtaque():EstadoTurno
}

class SinUnidad {
  + ocupaCasilla():boolean
  + recibirDanio(cantidad:int)
  + serEmpujada(orig:Casilla, dest:Casilla)
  + chocarCon(empujada:Unidad, orig:Casilla, dest:Casilla)
}

abstract class Vek {
  # Vek(vida:int, movimiento:int)
}
class Saltador {
  - {static} VIDA:int
  - {static} MOVIMIENTO:int
  + Saltador()
}
class Luciernaga {
  - {static} VIDA:int
  - {static} MOVIMIENTO:int
  + Luciernaga()
}
class Avispon {
  - {static} VIDA:int
  - {static} MOVIMIENTO:int
  + Avispon()
}

abstract class Mech {
  # Mech(vida:int, movimiento:int, arma:Arma)
  + atacar(orig:Posicion, obj:Posicion, t:Tablero)
}
class MechCombate {
  - {static} VIDA:int
  - {static} MOVIMIENTO:int
  + MechCombate()
}
class MechCanon {
  - {static} VIDA:int
  - {static} MOVIMIENTO:int
  + MechCanon()
}
class MechArtilleria {
  - {static} VIDA:int
  - {static} MOVIMIENTO:int
  + MechArtilleria()
}

abstract class Arma {
  + atacar(t:Tablero, orig:Posicion, obj:Posicion)
}

' 1. EstadoSalud debajo de Unidad
Unidad "1" -down-> "1" EstadoSalud
EstadoSalud <|.. Sano
EstadoSalud <|.. Contaminado

' 2. EstadoTurno debajo de EstadoSalud
Sano -[hidden]down-> EstadoTurno
Contaminado -[hidden]down-> EstadoTurno
Unidad "1" -down-> "1" EstadoTurno
EstadoTurno <|-down- Disponible
EstadoTurno <|-down- Movido
EstadoTurno <|-down- MovimientoDeshecho
EstadoTurno <|-down- MovidoSinRetorno
EstadoTurno <|-down- Agotado
Disponible -[hidden]down-> MovimientoDeshecho
Movido -[hidden]down-> MovidoSinRetorno
MovimientoDeshecho -[hidden]down-> Agotado

' 3. Subclases de Unidad debajo de EstadoTurno
Agotado -[hidden]down-> SinUnidad
Agotado -[hidden]down-> Vek
Unidad <|-down- SinUnidad
Unidad <|-down- Vek
Unidad <|-down- Mech

Vek <|-down- Saltador
Vek <|-down- Luciernaga
Vek <|-down- Avispon
Saltador -[hidden]down-> Avispon

Avispon -[hidden]down-> Mech
Mech "1" -right-> "1" Arma
Mech <|-down- MechCombate
Mech <|-down- MechCanon
Mech <|-down- MechArtilleria
MechCombate -[hidden]down-> MechArtilleria
@enduml