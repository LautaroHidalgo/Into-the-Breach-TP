@startuml
title Caso de éxito: Mech de Artillería dispara a una casilla objetivo, empuja a un Vek adyacente contra un Edificio y se descuenta Red Eléctrica

hide footbox
skinparam style strictuml
skinparam SequenceMessageAlign center

actor ":TestCase" as test
participant "mechArtilleria:Mech" as mech
participant ":Artilleria" as artilleria
participant "tablero:Tablero" as tablero
participant "casillaObjetivo:Casilla" as casillaObj
participant "vekObjetivo:Vek" as vekObj
participant "casillaAdyacente:Casilla" as casillaAdy
participant "vekAdyacente:Vek" as vekAdy
participant "casillaDestino:Casilla" as casillaEdificio
participant "edificio:Edificio" as edificio
participant "suelo:Suelo" as suelo
participant "redElectrica:RedElectrica" as red

test -> mech : atacar(casillaObjetivo, tablero)
activate mech

mech -> artilleria : dispararA(casillaObjetivo, tablero)
activate artilleria

' 1. Daño en la casilla objetivo (1 punto de daño)
artilleria -> casillaObj : recibirDanio(1)
activate casillaObj

casillaObj -> vekObj : recibirDanio(1)
activate vekObj
vekObj --> casillaObj
deactivate vekObj

casillaObj --> artilleria
deactivate casillaObj

' 2. Empuje hacia afuera en las 4 casillas adyacentes
    artilleria -> tablero : empujarAdyacente(casillaObjetivo, direccion)
    activate tablero
    
    tablero -> tablero : obtenerCasillaEnDireccion(casillaObjetivo, direccion)
    activate tablero
    tablero --> tablero : casillaAdyacente
    deactivate tablero

    tablero -> tablero : obtenerCasillaEnDireccion(casillaAdyacente, direccion)
    activate tablero
    tablero --> tablero : casillaDestino
    deactivate tablero

    tablero -> casillaAdy : empujarUnidadHacia(casillaDestino)
    activate casillaAdy

    ' 3. El Vek adyacente intenta ser desplazado hacia la casilla del Edificio
    casillaAdy -> vekAdy : empujarHacia(casillaDestino)
    activate vekAdy

    vekAdy -> casillaEdificio : recibirUnidadEmpujada(vekAdyacente)
    activate casillaEdificio

    ' Polimorfismo / Double Dispatch: la casilla delega en su terreno/ocupante (Edificio)
    casillaEdificio -> edificio : recibirUnidadEmpujada(vekAdyacente, casillaDestino)
    activate edificio

    ' Choque: la unidad empujada no se mueve y recibe 1 de daño de colisión
    edificio -> vekAdy : recibirDanio(1)
    activate vekAdy
    vekAdy --> edificio
    deactivate vekAdy

    ' El Edificio también recibe 1 de daño por la colisión
    edificio -> edificio : recibirDanio(1, casillaDestino)
    activate edificio

    ' 4. Descuento de la Red Eléctrica y destrucción del Edificio (pasa a ser Suelo)
    edificio -> red : descontarEnergia(1)
    activate red
    red --> edificio
    deactivate red

    create suelo
    edificio -> suelo : <<create>> Suelo()
    
    edificio -> casillaEdificio : cambiarTerreno(suelo)
    activate casillaEdificio
    casillaEdificio --> edificio
    deactivate casillaEdificio

    edificio --> edificio
    deactivate edificio

    edificio --> casillaEdificio
    deactivate edificio

    casillaEdificio --> vekAdy
    deactivate casillaEdificio

    vekAdy --> casillaAdy
    deactivate vekAdy

    casillaAdy --> tablero
    deactivate casillaAdy

    tablero --> artilleria
    deactivate tablero

artilleria --> mech
deactivate artilleria

mech --> test
deactivate mech
@enduml